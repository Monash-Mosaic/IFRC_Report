{
  "version": "0.2.0",
  "configurations": [
    {
      // Launch configuration for debugging Next.js applications without a browser.
      "name": "Next.js: debug full stack - no browser",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "runtimeArgs": ["--inspect"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // Launch configuration for debugging Next.js applications with a fresh instance of browser.
      "name": "Next.js: debug full stack",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "runtimeArgs": ["--inspect"],
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}"
      }
    },
    {
      "name": "Debug XML converter",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/wdr25/convert-xml.mjs",
      "runtimeArgs": ["--inspect-brk"],
      "args": [
        "--source",
        "WDR26-EN-01-test.with-links-and-endnotes.xml",
        "--mdx",
        "WDR26-EN-01-test.mdx"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}